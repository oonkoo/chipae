{
  "projectId": "c202f37f-133f-4159-b9a7-40763a784c07",
  "shape": "package",
  "pkg": "chipae",
  "globalName": "Chipae",
  "srcDir": "components",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".design-sync/.cache/chipae.css",
  "extraFonts": [".design-sync/fonts/fonts.css"],
  "docsDir": ".design-sync/docs",
  "readmeHeader": ".design-sync/conventions.md",
  "guidelinesGlob": ["design/art-direction.md"],
  "provider": {
    "component": "ChipaeTheme"
  },
  "overrides": {
    "Dialog": {
      "cardMode": "single",
