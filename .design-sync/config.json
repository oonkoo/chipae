    },
    "Popover": {
      "cardMode": "single",
      "primaryStory": "LobbySettings",
      "viewport": "460x420"
    }
  },
  "componentSrcMap": {
    "Button": "components/ui/button.tsx",
    "Card": "components/ui/card.tsx",
    "Input": "components/ui/input.tsx",
    "Label": "components/ui/label.tsx",
    "Dialog": "components/ui/dialog.tsx",
    "Popover": "components/ui/popover.tsx",
    "AvatarChip": "components/avatar-chip.tsx",
    "ChipMark": "components/chip-mark.tsx",
    "NunoCardFace": "components/game/nuno-card.tsx",
    "NunoCardBack": "components/game/nuno-card.tsx",
    "NunoCardFan": "components/game/nuno-card.tsx"
  }
}
